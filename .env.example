# Telegram
TELEGRAM_BOT_TOKEN=123456:replace-with-botfather-token

# OpenAI-compatible chat completions (Black Fox product support only)
AI_BASE_URL=https://your-ai-provider.example/v1
AI_API_KEY=sk-replace-me
AI_MODEL=replace-with-your-model

# Optional tuning
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.4
INTENT_CONFIDENCE_THRESHOLD=0.28
KNOWLEDGE_SNIPPET_CHARS=12000
LOG_LEVEL=INFO

# Nightly 3x-ui subscription creator (disabled by default)
NIGHTLY_ENABLED=false
NIGHTLY_IRAN_TIME=21:00
NIGHTLY_SUPPORT_CHAT_ID=@HiBlackFoxVpn
PANEL_BASE_URL=https://your-panel-domain/panel
PANEL_API_TOKEN=replace-with-3xui-panel-api-token
# One or more inbound IDs, comma-separated (e.g. 1 or 1,2,5)
PANEL_INBOUND_ID=1
# Legacy (unused): PANEL_REQUIRED_PORT=443

# Private-chat conversation analysis -> multilingual post drafts
CONVO_ANALYSIS_ENABLED=false
CONVO_ANALYSIS_TIMES=12:30
CONVO_ANALYSIS_CHAT_ID=replace-with-your-telegram-user-id
CONVO_ANALYSIS_TEST_MODE=true
CONVO_MIN_OCCURRENCES=3
CONVO_MIN_USERS=1
CONVO_PRIORITY_THRESHOLD=55

# Admin-only Bot Stats button (comma-separated Telegram user IDs)
BOT_ADMIN_IDS=replace-with-your-telegram-user-id
AI_BUDGET_USD=50
AI_USD_PER_MILLION_TOKENS=2.0
# Agent registry encrypts API keys with a key derived from TELEGRAM_BOT_TOKEN
# (no separate secret required). Change agents via Statistics → Change Agent & API.

# Safe-change watchdog (independent systemd unit):
# Admin: /safety_drill  /safety_status
# Flow: backup → apply → observe 60s → confirm to support (30s) → keep or auto-restore
SAFETY_CONFIRM_CHAT_ID=replace-with-your-telegram-user-id
# State: /opt/smart-support-bot-safety  Handshake: data/safety_request.json + safety_decision.json

# Verified Iran internet news -> Black Fox support account
SOCIAL_NEWS_ENABLED=true
SOCIAL_NEWS_CHAT_ID=@HiBlackFoxVPN
SOCIAL_NEWS_TIMES=10:00,17:00

# Live product catalog (source of truth = desktop app tree)
# VPS_TO_VPN_SOURCE=F:\VPS to VPN
# SOURCE_CATALOG_SYNC_ON_START=false
# Live catalog / media
# CATALOG_DEPLOY_ROOT=  (optional local mirror of server tree)
# BOT_SSH_HOST / BOT_SSH_USER / BOT_REMOTE_ROOT=/opt/smart-support
# Manager: python -m src.manager   → http://127.0.0.1:8766


# Optional: Telegram numeric IDs that can open Stats → Report (news). Owner (BOT_ADMIN_IDS) always can.
# NEWS_REPORT_ADMIN_IDS=123456789
