[Unit]
Description=Smart Support Bot safe-change watchdog (backup / confirm / auto-restore)
After=network-online.target smart-support-bot.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/smart-support
EnvironmentFile=/opt/smart-support/.env
ExecStart=/opt/smart-support/.venv/bin/python -m src.safety.watchdog_main
Restart=always
RestartSec=3
# Needs rights to restart the bot unit and write safety/install trees
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
