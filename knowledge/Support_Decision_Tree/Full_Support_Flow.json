{
  "meta": {
    "product": "Black Fox VPN Installer",
    "schema_version": "1.0.0",
    "languages": [
      "fa",
      "en",
      "ru",
      "zh"
    ],
    "intent_db": "AI_BOT_DATABASE/",
    "notes": [
      "Black Fox is an ops Installer (SSH/WireGuard/3X-UI), not a consumer browse VPN client.",
      "Connection trees focus on SSH, hubs, Proxy, panel reachability — not 'VPN connect button'.",
      "Never invent versions/prices/hosters. VPS only via FoxNext.net → Partners."
    ],
    "file": "Full_Support_Flow.json",
    "role": "Root conversation router for Telegram Bot / AI Assistant"
  },
  "entry": {
    "id": "support_root",
    "greeting": {
      "fa": "سلام. من دستیار پشتیبانی Black Fox هستم. لطفاً بفرمایید مشکل شما کدام است؟",
      "en": "Hi — I’m Black Fox support assistant. Which problem do you have?",
      "ru": "Здравствуйте. Я помощник поддержки Black Fox. Какая у вас проблема?",
      "zh": "你好，我是 Black Fox 支持助手。请问你的问题属于哪一类？"
    },
    "menu": [
      {
        "key": "1",
        "label": {
          "fa": "برنامه نصب نمی‌شود / باز نمی‌شود",
          "en": "App won't install / won't start",
          "ru": "Не устанавливается / не запускается",
          "zh": "无法安装 / 无法启动"
        },
        "goto": {
          "file": "Installation_Troubleshooting.json",
          "tree": "installation_failed"
        },
        "alt_tree": "app_wont_start",
        "ask_followup": {
          "fa": "نصب است یا اجرا؟ (نصب / اجرا)",
          "en": "Install or startup? (install / startup)",
          "ru": "Установка или запуск? (install / startup)",
          "zh": "是安装还是启动？（install / startup）"
        }
      },
      {
        "key": "2",
        "label": {
          "fa": "لایسنس فعال نمی‌شود",
          "en": "License won't activate",
          "ru": "Лицензия не активируется",
          "zh": "License 无法激活"
        },
        "goto": {
          "file": "License_Troubleshooting.json",
          "tree": "license_activation_failed"
        }
      },
      {
        "key": "3",
        "label": {
          "fa": "اتصال برقرار نمی‌شود (SSH/پنل/هاب)",
          "en": "Connection problem (SSH/panel/hub)",
          "ru": "Проблема соединения (SSH/панель/хаб)",
          "zh": "连接问题（SSH/面板/Hub）"
        },
        "goto": {
          "file": "Connection_Troubleshooting.json",
          "tree": "connection_problem"
        }
      },
      {
        "key": "4",
        "label": {
          "fa": "آپدیت",
          "en": "Update",
          "ru": "Обновление",
          "zh": "更新"
        },
        "goto": {
          "file": "Update_Troubleshooting.json",
          "tree": "update_failed"
        }
      },
      {
        "key": "5",
        "label": {
          "fa": "سرور / پنل / DNS / Deploy",
          "en": "Server / panel / DNS / Deploy",
          "ru": "Сервер / панель / DNS / Deploy",
          "zh": "服务器 / 面板 / DNS / Deploy"
        },
        "goto": {
          "file": "Server_Troubleshooting.json",
          "tree": "server_problems"
        }
      },
      {
        "key": "6",
        "label": {
          "fa": "سایر / نمی‌دانم",
          "en": "Other / not sure",
          "ru": "Другое / не уверен",
          "zh": "其他 / 不确定"
        },
        "goto": {
          "file": "General_Error_Troubleshooting.json",
          "tree": "general_error"
        }
      }
    ]
  },
  "conversation_policy": {
    "max_auto_steps_before_escalate": 5,
    "always_ask_before_destructive": true,
    "never_invent": [
      "version_numbers",
      "prices",
      "hosting_brands"
    ],
    "vps_purchase_only": "FoxNext.net → Partners",
    "human_handoff": "@HiBlackFoxVpn",
    "language_match_user": true,
    "link_intent_db": "AI_BOT_DATABASE/intents/intents_{lang}.json",
    "on_unresolved": {
      "fa": "اگر بعد از مراحل درخت حل نشد: Device ID + اسکرین خطا + مرحله شکست را بفرستید.",
      "en": "If still unresolved after the tree: send Device ID + error screenshot + failing step.",
      "ru": "Если не решено после дерева: Device ID + скрин ошибки + шаг сбоя.",
      "zh": "若决策树后仍未解决：发送 Device ID + 错误截图 + 失败步骤。"
    }
  },
  "stage_template": {
    "stage1_first_question": "Use entry.greeting + entry.menu (localized).",
    "stage2_branch": "Load target tree entry_node; ask diagnostic question; follow answers[].next.",
    "stage3_solution": "Execute type=action nodes; present action + solution.",
    "stage4_if_unresolved": "Follow if_unresolved → escalate node; collect ask_for; offer human_handoff."
  }
}